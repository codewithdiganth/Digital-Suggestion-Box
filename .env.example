
SECRET_KEY=replace-this-with-a-random-secret
DATABASE_URL=sqlite:///suggestions.db
APP_ENV=development
# Set APP_ENV=production when deploying behind HTTPS.
# SESSION_COOKIE_SECURE can override the APP_ENV-based setting if needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMTP settings are required for administrator-created account setup/reset emails.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Set this to the canonical public URL in production; keep it on HTTPS.
PUBLIC_BASE_URL=http://127.0.0.1:5000
.env
.env.example